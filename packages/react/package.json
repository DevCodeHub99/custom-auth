{
  "name": "@custom-auth/react",
  "version": "1.0.6",
  "description": "React hooks and context providers for @custom-auth.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --watch"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "keywords": [
    "auth",
    "authentication",
    "react",
    "hooks",
    "context",
    "session",
    "custom-auth"
  ]
}
