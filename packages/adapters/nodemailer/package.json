{
  "name": "@custom-auth/adapter-nodemailer",
  "version": "1.0.0",
  "description": "SMTP email adapter for @custom-auth/core \u2014 works with Gmail, Zoho, Brevo, Mailgun, Postmark, Office365, AWS SES, and any custom SMTP server",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "nodemailer": "^6.9.13"
  },
  "peerDependencies": {
    "@custom-auth/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@custom-auth/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@custom-auth/core": "1.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
