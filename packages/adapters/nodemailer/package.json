{
  "name": "@custom-auth/adapter-nodemailer",
  "version": "1.0.7",
  "description": "Nodemailer email adapter for @custom-auth.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "nodemailer": "^6.9.13"
  },
  "peerDependencies": {
    "@custom-auth/core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@custom-auth/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@custom-auth/core": "1.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "keywords": [
    "auth",
    "authentication",
    "nodemailer",
    "email",
    "smtp",
    "adapter",
    "magic-link",
    "custom-auth"
  ]
}
