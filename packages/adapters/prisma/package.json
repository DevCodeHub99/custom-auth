{
  "name": "@custom-auth/prisma",
  "version": "1.0.0",
  "description": "Prisma adapter for custom-auth",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@custom-auth/core": "*"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "prisma": "^5.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
