{
  "name": "@custom-auth/drizzle",
  "version": "1.0.9",
  "description": "Drizzle ORM database adapter for @custom-auth.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.10"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "@custom-auth/core": "1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "keywords": [
    "auth",
    "authentication",
    "drizzle",
    "adapter",
    "database",
    "orm",
    "custom-auth"
  ]
}
