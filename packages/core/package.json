{
  "name": "@custom-auth/core",
  "version": "1.0.5",
  "description": "The framework-agnostic core engine for @custom-auth.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^5.2.4",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "keywords": [
    "auth",
    "authentication",
    "session",
    "mfa",
    "rbac",
    "custom-auth",
    "security",
    "oauth"
  ]
}
