{
  "name": "@custom-auth/nextjs",
  "version": "1.0.10",
  "description": "Edge-compatible Next.js helpers and middleware for @custom-auth.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "jose": "^5.2.4"
  },
  "peerDependencies": {
    "next": ">=13"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "keywords": [
    "auth",
    "authentication",
    "nextjs",
    "react",
    "middleware",
    "edge",
    "session",
    "custom-auth"
  ]
}
