{
  "name": "custom-auth-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core --workspace=packages/react --workspace=packages/nextjs --workspace=packages/adapters/prisma --workspace=packages/adapters/mongoose --workspace=packages/adapters/drizzle --workspace=packages/adapters/nodemailer --workspace=packages/adapters/resend --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsup": "^8.0.2",
    "@types/node": "^20.12.7"
  },
  "author": "Vikas <vikasmukhiya1999>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCodeHub99/custom-auth.git"
  },
  "bugs": {
    "url": "https://github.com/DevCodeHub99/custom-auth/issues"
  },
  "homepage": "https://github.com/DevCodeHub99/custom-auth#readme",
  "version": "0.0.3"
}
