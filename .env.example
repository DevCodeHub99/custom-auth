# ── Required ────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# MONGODB_URI=mongodb://localhost:27017/mydb

# ── Email — SMTP (pick one provider, see README for all presets) ──────────────
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password-or-key

# ── Email — Resend (edge-compatible alternative) ──────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ── OAuth — Google ────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App URL (used to build email verification / reset links) ──────────────────
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Redis (for production rate limiting) ───────────────────────────
# REDIS_URL=redis://localhost:6379
